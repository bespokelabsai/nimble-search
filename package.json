{
  "name": "nimble-search",
  "version": "0.1.0",
  "description": "Semantic file search for coding agents (Claude Code, Codex, Antigravity) powered by Bespoke Labs Nimble",
  "type": "module",
  "license": "MIT",
  "bin": {
    "nimble-search": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "configs",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "build:test": "tsc -p tsconfig.test.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "npm run build:test && node --test dist-test/test/*.test.js",
    "dev": "tsc -w -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "ignore": "^7.0.3",
    "zod": "^3.25.32"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
